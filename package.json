{
  "name": "pi-ui",
  "version": "0.1.1",
  "description": "Desktop UI for Pi Coding Agent with Antigravity-like 3-pane layout",
  "author": "Pi-UI Contributors",
  "license": "MIT",
  "main": "electron/main.cjs",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "preview": "vite preview",
    "desktop": "electron .",
    "electron:dev": "concurrently -k \"vite\" \"wait-on tcp:5173 && cross-env ELECTRON_DEV_URL=http://localhost:5173 electron .\"",
    "electron:start": "electron .",
    "fetch-core": "node scripts/fetch-core.mjs",
    "pack:win": "npm run build && npm run fetch-core && electron-builder --win dir --x64",
    "dist:win": "npm run build && npm run fetch-core && electron-builder --win nsis --x64 --publish never"
  },
  "dependencies": {
    "node-pty": "^1.1.0"
  },
  "devDependencies": {
    "@monaco-editor/react": "^4.7.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "@xterm/addon-fit": "^0.10.0",
    "@xterm/xterm": "^5.5.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "concurrently": "^9.1.0",
    "cross-env": "^7.0.3",
    "electron": "44.9.3",
    "electron-builder": "26.15.3",
    "highlight.js": "^11.12.0",
    "lucide-react": "^1.16.0",
    "monaco-editor": "^0.57.0",
    "postcss": "^8.4.49",
    "react": "^18.3.1",
    "react-arborist": "^4.0.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "tailwind-merge": "^2.5.4",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "wait-on": "^8.0.1"
  },
  "build": {
    "appId": "com.pi-ui.desktop",
    "productName": "Pi Agent Desktop",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json",
      "!node_modules/node-pty/{src,deps,third_party,scripts}/**",
      "!node_modules/node-pty/binding.gyp",
      "!node_modules/node-pty/prebuilds/{darwin-*,win32-arm64,linux-*}/**",
      "!**/*.pdb"
    ],
    "extraResources": [
      {
        "from": "resources/pi-core",
        "to": "pi-core"
      }
    ],
    "asar": false,
    "npmRebuild": false,
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "artifactName": "PiAgentDesktop-Setup-${version}-${arch}.${ext}"
    }
  }
}
